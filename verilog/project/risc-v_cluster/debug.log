  for i in gcc-ar gcc-nm gcc-ranlib; do \
    install_name=`echo $i|sed 's&^&riscv32-unknown-elf-&'` ;\
    target_install_name=riscv32-unknown-elf-`echo $i|sed 's&^&riscv32-unknown-elf-&'` ; \
    rm -f /opt/riscv32i/bin/$install_name ; \
    /usr/bin/install -c $i /opt/riscv32i/bin/$install_name ;\
    if test -f gcc-cross; then \
      :; \
    else \
      rm -f /opt/riscv32i/bin/$target_install_name; \
      ( cd /opt/riscv32i/bin && \
	ln $install_name $target_install_name ) ; \
    fi ; \
