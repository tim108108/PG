  dest=/opt/riscv32i/lib/gcc/riscv32-unknown-elf/8.2.0/plugin/include/cp/$file; \
  echo /usr/bin/install -c -m 644 $path $dest; \
  dir=`dirname $dest`; \
  /bin/bash ../../../riscv-gcc/gcc/../mkinstalldirs $dir; \
  /usr/bin/install -c -m 644 $path $dest; \
done
if /bin/bash -c 'install-info --version' >/dev/null 2>&1; then \
