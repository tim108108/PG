for file in $headers; do \
  if [ -f $file ] ; then \
    path=$file; \
  elif [ -f ../../../riscv-gcc/gcc/$file ]; then \
    path=../../../riscv-gcc/gcc/$file; \
  else continue; \
  fi; \
  case $path in \
  "../../../riscv-gcc/gcc"/config/* | "../../../riscv-gcc/gcc"/c-family/* | "../../../riscv-gcc/gcc"/*.def ) \
    base=`echo "$path" | sed -e "s|$srcdirstrip/||"`;; \
  *) base=`basename $path` ;; \
  esac; \
  dest=/opt/riscv32i/lib/gcc/riscv32-unknown-elf/8.2.0/plugin/include/$base; \
  echo /usr/bin/install -c -m 644 $path $dest; \
  dir=`dirname $dest`; \
  /bin/bash ../../../riscv-gcc/gcc/../mkinstalldirs $dir; \
  /usr/bin/install -c -m 644 $path $dest; \
done
